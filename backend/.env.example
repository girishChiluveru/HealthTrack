# Copy to backend/.env. These values match the local Docker Compose defaults.
DATABASE_URL=postgresql+psycopg://healthtrack:change-me-local-only@127.0.0.1:5432/healthtrack

# Comma-separated list of allowed origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173

# Required, at least 32 characters. Left blank so that no shared secret is ever used.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional. One of HS256, HS384, HS512.
JWT_ALGORITHM=HS256

# Optional. Leave the key blank to run without AI insights.
# AI_PROVIDER is groq or openrouter. AI_MODEL overrides the provider's default.
AI_PROVIDER=groq
AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_SECONDS=30
